          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Psybeam sugere o idioma local do lugar onde você está ao cruzar fronteiras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam 会在你跨越国界时，根据所在位置建议当地语言。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
