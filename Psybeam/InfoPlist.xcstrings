{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt. The camera is never used; the realtime audio framework requests it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam macht keine Fotos oder Videos. Der Kamerazugriff wird nur vom Echtzeit-Audio-Framework angefragt und nie genutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam does not take photos or videos. Camera access is requested only by the real-time audio framework and is never used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam no toma fotos ni vídeos. El acceso a la cámara solo lo solicita el framework de audio en tiempo real y nunca se usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam ne prend ni photos ni vidéos. L’accès à l’appareil photo est uniquement demandé par le framework audio en temps réel et n’est jamais utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam non scatta foto né registra video. L’accesso alla fotocamera viene richiesto solo dal framework audio in tempo reale e non viene mai utilizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeamは写真やビデオを撮影しません。カメラへのアクセスはリアルタイム音声フレームワークが要求するもので、実際には使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam은 사진이나 동영상을 촬영하지 않습니다. 카메라 접근 권한은 실시간 오디오 프레임워크가 요청할 뿐이며 실제로 사용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Psybeam não tira fotos nem grava vídeos. O acesso à câmera é solicitado apenas pelo framework de áudio em tempo real e nunca é usado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam 不会拍摄照片或视频。相机权限仅由实时音频框架请求，实际从不使用。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt shown before GPS suggests the local language.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam schlägt dir beim Grenzübertritt die Sprache deines aktuellen Standorts vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam suggests the local language for where you are as you cross borders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam sugiere el idioma local del lugar donde estás cuando cruzas fronteras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam suggère la langue locale de l’endroit où vous êtes lorsque vous franchissez une frontière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam suggerisce la lingua locale del posto in cui ti trovi quando attraversi un confine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeamは、国境を越えるたびに現在地の言語を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
