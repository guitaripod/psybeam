    "You can withdraw consent anytime in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Zustimmung jederzeit in den Einstellungen widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes retirar tu consentimiento en cualquier momento en Ajustes."
          }
