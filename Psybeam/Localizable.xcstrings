    "Psybeam needs your OK to send speech to its cloud translator." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam braucht dein Okay, um Gesprochenes an seinen Cloud-Übersetzer zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam necesita tu permiso para enviar lo que se dice a su traductor en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam a besoin de votre accord pour envoyer la voix à son traducteur dans le cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam ha bisogno del tuo consenso per inviare la voce al suo traduttore nel cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeamが音声をクラウドの翻訳サービスに送るには、あなたの同意が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam이 음성을 클라우드 번역기로 보내려면 동의가 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Psybeam precisa da sua permissão para enviar a fala ao tradutor na nuvem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam 需要你的同意，才能把语音发送到云端翻译服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam 需要你的同意，才能將語音傳送到雲端翻譯服務。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Psybeam إلى موافقتك لإرسال الكلام إلى مترجمه السحابي."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam нужно ваше согласие, чтобы отправлять речь облачному переводчику."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam'in konuşmayı bulut çevirmenine gönderebilmesi için onayınız gerekiyor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam ต้องได้รับความยินยอมจากคุณก่อน จึงจะส่งเสียงพูดไปยังตัวแปลบนคลาวด์ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam cần bạn đồng ý để gửi giọng nói đến trình dịch trên đám mây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam memerlukan persetujuan Anda untuk mengirim ucapan ke penerjemah cloud-nya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam heeft uw toestemming nodig om spraak naar de cloudvertaler te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam potrzebuje twojej zgody, aby wysyłać mowę do tłumacza w chmurze."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ को क्लाउड अनुवादक तक भेजने के लिए Psybeam को आपकी अनुमति चाहिए।"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-Psybeam נדרש האישור שלכם כדי לשלוח דיבור למתרגם בענן."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Psybeam χρειάζεται τη συγκατάθεσή σας για να στέλνει την ομιλία στον μεταφραστή του στο cloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam tarvitsee lupasi, jotta se voi lähettää puhetta pilvessä toimivalle kääntäjälle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psybeam behöver ditt godkännande för att skicka tal till sin molnöversättare."
          }
        }
      }
    },
