        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุยกับใครก็ได้ในภาษาของเขา Psybeam แปลเสียงเป็นเสียงระหว่างที่คุณเดินทาง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trò chuyện với bất kỳ ai bằng ngôn ngữ của họ. Psybeam dịch giọng nói sang giọng nói khi bạn đi du lịch."
