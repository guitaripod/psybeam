    "Voice Isolation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmisolation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aislamiento de voz"
          }
        },
        "fr" : {
          "stringUnit" : {
