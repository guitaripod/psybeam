    "Talk to anyone in their language. Psybeam translates voice to voice while you travel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich mit jedem in seiner Sprache. Psybeam übersetzt auf Reisen Stimme zu Stimme."
