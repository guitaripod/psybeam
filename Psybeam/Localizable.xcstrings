            "value" : "Isolamento voce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声を分離"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 분리"
          }
        },
