    "Now hold %@ and answer — or let someone answer you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jetzt „%@“ gedrückt und antworte – oder lass dir von jemandem antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mantén pulsado «%@» y responde, o deja que alguien te responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez maintenant « %@ » et répondez, ou laissez quelqu’un vous répondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora tieni premuto «%@» e rispondi, oppure lascia che qualcuno ti risponda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次は「%@」を長押しして答えてみましょう。誰かに答えてもらってもOKです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 ‘%@’ 버튼을 길게 누르고 대답해 보세요. 다른 사람이 대답해도 좋아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora segure “%@” e responda — ou deixe alguém responder para você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在按住“%@”回答，或者请别人来回答你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在按住「%@」回答，或是請別人來回答你。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآن اضغط مطولًا على «%@» وأجب، أو دع شخصًا آخر يجيبك."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь удерживайте «%@» и ответьте — или дайте ответить кому-то другому."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi “%@” düğmesini basılı tutup yanıt verin ya da size başka biri yanıt versin."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้กด “%@” ค้างไว้แล้วตอบ หรือให้คนอื่นตอบคุณก็ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ hãy giữ “%@” và trả lời — hoặc để ai đó trả lời bạn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang tahan “%@” lalu jawab — atau biarkan orang lain menjawab Anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd nu ‘%@’ ingedrukt en antwoord — of laat iemand anders u antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz przytrzymaj „%@” i odpowiedz — albo niech ktoś ci odpowie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब “%@” दबाए रखें और जवाब दें — या किसी और को जवाब देने दें।"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עכשיו החזיקו את \"%@\" וענו — או תנו למישהו אחר לענות לכם."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα κρατήστε πατημένο το «%@» και απαντήστε — ή αφήστε κάποιον άλλον να σας απαντήσει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä nyt ”%@” painettuna ja vastaa – tai anna jonkun muun vastata sinulle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll nu in ”%@” och svara – eller låt någon annan svara dig."
          }
        }
      }
    },
