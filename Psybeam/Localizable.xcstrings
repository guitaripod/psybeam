    "Hold %@ and say something. You’ll hear it in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte „%1$@“ gedrückt und sag etwas. Du hörst es auf %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado «%1$@» y di algo. Lo oirás en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez « %1$@ » et dites quelque chose. Vous l’entendrez en %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto «%1$@» e di’ qualcosa. Lo sentirai in %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」を長押しして、何か話してみてください。%2$@で聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 버튼을 길게 누르고 아무 말이나 해 보세요. %2$@로 들려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure “%1$@” e diga alguma coisa. Você vai ouvir em %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住“%1$@”随便说句话，就能听到%2$@翻译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住「%1$@」隨便說句話，就能聽到%2$@翻譯。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على «%1$@» وقل أي شيء. ستسمعه باللغة %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте «%1$@» и скажите что-нибудь. Перевод прозвучит на языке: %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” düğmesini basılı tutun ve bir şey söyleyin. %2$@ olarak duyacaksınız."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด “%1$@” ค้างไว้แล้วพูดอะไรก็ได้ คุณจะได้ยินเป็นภาษา%2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ “%1$@” và nói gì đó. Bạn sẽ nghe thấy bằng %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan “%1$@” lalu ucapkan sesuatu. Anda akan mendengarnya dalam bahasa %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ‘%1$@’ ingedrukt en zeg iets. U hoort het in het %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj „%1$@” i powiedz coś. Usłyszysz to w języku: %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” दबाए रखें और कुछ भी कहें। आपको यह %2$@ में सुनाई देगा।"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזיקו את \"%1$@\" ואמרו משהו. תשמעו את זה ב%2$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένο το «%1$@» και πείτε κάτι. Θα το ακούσετε στα %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ”%1$@” painettuna ja sano jotain. Kuulet sen kielellä %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll in ”%1$@” och säg något. Du hör det på %2$@."
          }
        }
      }
    },
